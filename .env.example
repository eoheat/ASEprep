# ase-prep environment variables (M6-M8).
# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings
# → Environment Variables for production. NEVER commit real secrets — .env and
# .env*.local are gitignored; this .example file is the committed template.

# --- M7: database (Neon Postgres, serverless driver) ---
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- M7: Auth.js (NextAuth v5) ---
# Generate a secret with:  openssl rand -base64 32
AUTH_SECRET="replace-me"
# GitHub OAuth app (github.com → Settings → Developer settings → OAuth Apps → New):
#   Homepage URL:               https://<your-app>.vercel.app
#   Authorization callback URL: https://<your-app>.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID="replace-me"
AUTH_GITHUB_SECRET="replace-me"

# Single-user allowlist: your numeric GitHub user id
# (find it at https://api.github.com/users/<your-login> → the "id" field).
# Anyone else is rejected at sign-in — this app is not multi-user.
ALLOWED_GITHUB_ID="replace-me"

# ase-prep environment variables (M7-M8).
# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings
# → Environment Variables for production. NEVER commit real secrets — .env and
# .env*.local are gitignored; this .example file is the committed template.

# --- database (Neon Postgres, serverless driver) ---
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js (NextAuth v5) — open Google sign-in (anyone with a Google account) ---
# Generate a secret with:  openssl rand -base64 32
AUTH_SECRET="replace-me"
# Google OAuth client: Google Cloud Console → APIs & Services → Credentials →
# Create credentials → OAuth client ID → Web application. Authorized redirect URIs:
#   https://<your-app>.vercel.app/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google        (for local dev)
AUTH_GOOGLE_ID="replace-me.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="replace-me"
